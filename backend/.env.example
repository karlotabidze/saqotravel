# Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# Google Cloud server key: Places API (New) only; restrict by API.
GOOGLE_PLACES_API_KEY=replace_me

# Public Maps JavaScript key: restrict by HTTP referrers + Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=replace_me

# Random long secret used to protect manual sync endpoint.
SYNC_TOKEN=replace_with_a_long_random_secret

PORT=10000
PLACES_LANGUAGE_CODE=ka
DETAILS_PAGE_SIZE=30
